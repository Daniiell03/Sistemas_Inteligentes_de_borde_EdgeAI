[Unit]
Description=Calentamiento de los modelos de inferencia de Jarvis
Documentation=https://github.com/Daniiell03/Sistemas_Inteligentes_de_borde_EdgeAI
After=ollama.service
Requires=ollama.service
Before=jarvis.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/jarvis/jarvis-warmup.sh

# El calentamiento de dos modelos sobre CPU ARM puede tardar varios minutos
# en el primer arranque. El limite es amplio a proposito.
TimeoutStartSec=600

# Sin reintentos: si Ollama no esta disponible tras la espera interna,
# el problema es de la plataforma y debe verse en el journal.
Restart=no

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
