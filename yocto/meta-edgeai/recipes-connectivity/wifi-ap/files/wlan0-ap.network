# Direccion estatica de la interfaz del punto de acceso.
#
# El equipo es siempre 192.168.4.1 en su propia red. No pide direccion a
# nadie ni ofrece ruta hacia afuera: no hay afuera.

[Match]
Name=wlan0

[Network]
Address=192.168.4.1/24
DHCPServer=no
IPForward=no
LinkLocalAddressing=no

# El descubrimiento por nombre permite alcanzar el equipo como jarvis.local
# desde cualquier cliente conectado, sin recordar la direccion.
MulticastDNS=yes

[Link]
RequiredForOnline=no
